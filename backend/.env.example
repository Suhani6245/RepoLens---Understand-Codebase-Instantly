# Server
PORT=4000
NODE_ENV=development

# CORS - the frontend origin allowed to call this API
FRONTEND_ORIGIN=http://localhost:5173

# Gemini API key (required for /api/explain, /api/repository/:id/architecture,
# and /api/question — see src/ai/geminiClient.ts)
GEMINI_API_KEY=

# GitHub personal access token (optional - raises API rate limits)
GITHUB_TOKEN=

# Where repositories are shallow-cloned to during analysis
CLONE_WORKSPACE_DIR=/tmp/repolens
